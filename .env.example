# ── Trafikverket ─────────────────────────────────────────────────────
# Free API key: register at https://data.trafikverket.se/ (Mina sidor → API-nycklar)
TRAFIKVERKET_API_KEY=

# ── Access control (both optional) ───────────────────────────────────
# Leave MCP_API_KEY empty for an open server (default).
# Set it to any string you like to require it: paste the SAME string into Intric's "Api Key" field.
MCP_API_KEY=
# Comma-separated client IPs allowed to reach the server. "*" = allow all.
ALLOWED_IPS=*

# Optional: override the icon shown in Intric (must be an absolute public URL)
# MCP_ICON_URL=https://raw.githubusercontent.com/SimonBerg255/trafikverket-mcp/main/icon.png
