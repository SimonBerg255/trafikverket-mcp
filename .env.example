# Everything here is OPTIONAL.
#
# Recommended setup: leave TRAFIKVERKET_API_KEY empty, register the server in Intric with auth mode
# "API key" and paste your Trafikverket key (free at https://data.trafikverket.se/) there. Intric sends it
# as a Bearer token on every call and the server forwards it to Trafikverket.
#
# Alternative: set TRAFIKVERKET_API_KEY here and use auth mode "None" in Intric (shared key for everyone).
TRAFIKVERKET_API_KEY=

# Comma-separated client IPs allowed to reach the server. "*" = allow all.
ALLOWED_IPS=*

# Optional: override the icon shown in Intric (must be an absolute public URL)
# MCP_ICON_URL=https://raw.githubusercontent.com/SimonBerg255/trafikverket-mcp/main/icon.png
